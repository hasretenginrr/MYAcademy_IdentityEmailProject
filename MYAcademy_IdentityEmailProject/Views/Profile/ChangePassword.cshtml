@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ActiveMenu"] = "settings";
    Layout = "~/Views/MessageLayout/Index.cshtml";
    var flash = TempData["Flash"] as string;
}

<section class="msg-page">
    <div class="mp-card" style="max-width:520px">
        <h1 class="pv-subject mb-1">Şifre değiştir</h1>
        <p class="text-muted mb-4">Güvenliğiniz için önce mevcut şifrenizi doğrulayın.</p>

        @if (flash != null)
        {
            <div class="alert alert-success py-2">@flash</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <form method="post" asp-controller="Profile" asp-action="ChangePassword" novalidate>
            <div class="mb-3">
                <label class="form-label fw-semibold" asp-for="CurrentPassword">Mevcut şifre</label>
                <input class="form-control" asp-for="CurrentPassword" autocomplete="current-password">
                <span class="text-danger small" asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" asp-for="NewPassword">Yeni şifre</label>
                <input class="form-control" asp-for="NewPassword" autocomplete="new-password">
                <span class="text-danger small" asp-validation-for="NewPassword"></span>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold" asp-for="ConfirmPassword">Yeni şifre (tekrar)</label>
                <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password">
                <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
            </div>
            <button type="submit" class="btn-soft"><i class="bi bi-check2-circle"></i> Şifreyi güncelle</button>
        </form>
    </div>
</section>