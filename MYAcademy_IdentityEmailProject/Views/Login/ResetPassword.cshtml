@model ResetPasswordViewModel
@{
    Layout = null;
    var error = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
    string FieldError(string key) => ViewData.ModelState.TryGetValue(key, out var e) ? e.Errors.FirstOrDefault()?.ErrorMessage ?? "" : "";
    var passErr = FieldError(nameof(Model.NewPassword));
    var confErr = FieldError(nameof(Model.ConfirmPassword));
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Yeni Şifre · Mailora</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* Mailora teması. Razor'da CSS/JS içindeki at işareti iki kez yazılır. */
        :root {
            --bg: #F8F9FD;
            --card: #FFFFFF;
            --accent: #8B7FD6;
            --accent-dark: #7467C7;
            --lavender: #EAE6FA;
            --blue: #E8F2FF;
            --mint: #E3F5EE;
            --text: #303348;
            --muted: #85899B;
            --border: #ECEBF5;
            --danger: #C2476B;
            --shadow-lg: 0 24px 60px rgba(91, 80, 170, .16);
            --ease: cubic-bezier(.4, 0, .2, 1);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            min-height: 100%;
        }

        body {
            margin: 0;
            font-family: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        a {
            color: var(--accent-dark);
            text-decoration: none;
        }

            a:hover {
                color: var(--accent);
            }

        button {
            font-family: inherit;
        }

        .auth-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
        }

            .auth-bg span {
                position: absolute;
                border-radius: 50%;
                filter: blur(60px);
                opacity: .75;
            }

            .auth-bg .g1 {
                width: 520px;
                height: 520px;
                background: var(--lavender);
                top: -180px;
                left: -140px;
            }

            .auth-bg .g2 {
                width: 460px;
                height: 460px;
                background: var(--blue);
                bottom: -200px;
                right: -120px;
            }

            .auth-bg .g3 {
                width: 300px;
                height: 300px;
                background: var(--mint);
                top: 40%;
                left: 55%;
                opacity: .5;
            }

        .page {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
            margin-bottom: 24px;
        }

            .brand:hover {
                color: var(--text);
            }

        .brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            background: linear-gradient(135deg, #A99DF0 0%, var(--accent) 55%, #6F63C4 100%);
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 19px;
            box-shadow: 0 6px 16px rgba(139, 127, 214, .35);
        }

        .brand-name {
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -.4px;
        }

            .brand-name span {
                color: var(--accent);
            }

        .card-x {
            position: relative;
            width: 100%;
            max-width: 460px;
            background: var(--card);
            border-radius: 28px;
            box-shadow: var(--shadow-lg);
            padding: 40px 40px 30px;
            overflow: hidden;
            animation: cardIn .5s var(--ease);
        }

            .card-x::before {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                height: 150px;
                pointer-events: none;
                background: radial-gradient(circle, rgba(255, 255, 255, .85) 1.4px, transparent 2px) 0 0 / 22px 22px, linear-gradient(180deg, #EFEBFC 0%, rgba(239, 235, 252, 0) 100%);
            }

            .card-x > * {
                position: relative;
            }

        @@keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .head {
            text-align: center;
            margin-bottom: 26px;
        }

        h1 {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: -.6px;
            margin: 0 0 8px;
        }

        .sub {
            color: var(--muted);
            font-size: 14.5px;
            line-height: 1.6;
            margin: 0;
        }

        .alert-x {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 18px;
            padding: 12px 14px;
            border-radius: 13px;
            background: #FFF1F5;
            color: var(--danger);
            font-size: 13px;
            font-weight: 500;
            line-height: 1.5;
        }

            .alert-x i {
                margin-top: 1px;
            }

        .field {
            margin-bottom: 16px;
        }

            .field label {
                display: block;
                font-size: 13px;
                font-weight: 700;
                margin-bottom: 7px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap .lead {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
                font-size: 16px;
                pointer-events: none;
            }

        .a-input {
            width: 100%;
            height: 50px;
            padding: 0 44px 0 44px;
            border: 1.5px solid var(--border);
            border-radius: 14px;
            background: var(--bg);
            font: inherit;
            font-size: 14.5px;
            color: var(--text);
            outline: none;
            transition: border-color .2s, background .2s, box-shadow .2s;
        }

            .a-input::placeholder {
                color: #A9ACBC;
            }

            .a-input:hover {
                border-color: #DEDBEE;
            }

            .a-input:focus {
                background: #fff;
                border-color: #BFB6EE;
                box-shadow: 0 0 0 4px rgba(139, 127, 214, .14);
            }

        .field.has-error .a-input {
            border-color: #EFAFC3;
            background: #FFF8FA;
        }

        .eye {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border: 0;
            border-radius: 10px;
            background: none;
            color: var(--muted);
            display: grid;
            place-items: center;
            font-size: 16px;
        }

            .eye:hover {
                background: #F1F0FB;
                color: var(--accent-dark);
            }

        .field-msg {
            min-height: 0;
            margin-top: 6px;
            font-size: 12.5px;
            color: var(--danger);
        }

        .btn-primary-x {
            width: 100%;
            height: 52px;
            margin-top: 8px;
            border: 0;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, #9C91E2 0%, var(--accent) 50%, var(--accent-dark) 100%);
            background-size: 160% 100%;
            box-shadow: 0 10px 24px rgba(139, 127, 214, .38);
            transition: transform .2s var(--ease), box-shadow .2s var(--ease), background-position .4s var(--ease), opacity .2s;
        }

            .btn-primary-x:hover:not(:disabled) {
                transform: translateY(-2px);
                background-position: 100% 0;
                box-shadow: 0 14px 30px rgba(139, 127, 214, .45);
            }

            .btn-primary-x.loading {
                opacity: .9;
                cursor: wait;
            }

        .spinner-sm {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, .35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .card-foot {
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px dashed var(--border);
            font-size: 13.5px;
            text-align: center;
            color: #5D6075;
        }

            .card-foot a {
                font-weight: 700;
            }

        .page-foot {
            margin-top: 20px;
            font-size: 12px;
            color: var(--muted);
            text-align: center;
        }

        @@media (max-width: 575.98px) {
            .page {
                padding: 20px 14px;
                justify-content: flex-start;
            }

            .brand {
                margin: 8px 0 18px;
            }

            .card-x {
                padding: 32px 20px 24px;
                border-radius: 24px;
            }

            h1 {
                font-size: 22px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>
<body>

    <div class="auth-bg" aria-hidden="true"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>

    <main class="page">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Mailora ana sayfa">
            <span class="brand-logo"><i class="bi bi-envelope-paper-heart-fill"></i></span>
            <span class="brand-name">Mail<span>ora</span></span>
        </a>
        <section class="card-x">
            <div class="head">
                <h1>Yeni şifre belirleyin</h1>
                <p class="sub">Hesabınız için yeni bir şifre seçin.</p>
            </div>

            @if (error != null)
            {
                <div class="alert-x" role="alert"><i class="bi bi-exclamation-circle-fill"></i><span>@error</span></div>
            }

            <form method="post" asp-controller="Login" asp-action="ResetPassword" novalidate>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="field @(passErr != "" ? "has-error" : "")">
                    <label for="newPassword">Yeni şifre</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock lead"></i>
                        <input class="a-input" id="newPassword" asp-for="NewPassword" type="password" autocomplete="new-password">
                    </div>
                    <div class="field-msg">@passErr</div>
                </div>

                <div class="field @(confErr != "" ? "has-error" : "")">
                    <label for="confirmPassword">Yeni şifre (tekrar)</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock-fill lead"></i>
                        <input class="a-input" id="confirmPassword" asp-for="ConfirmPassword" type="password" autocomplete="new-password">
                    </div>
                    <div class="field-msg">@confErr</div>
                </div>

                <button type="submit" class="btn-primary-x"><i class="bi bi-check2-circle"></i><span>Şifreyi Güncelle</span></button>
            </form>
            <div class="card-foot"><a asp-controller="Login" asp-action="SignIn">Giriş sayfasına dön</a></div>
        </section>

        <div class="page-foot">© 2026 Mailora · <i class="bi bi-lock-fill"></i> Bağlantınız SSL ile korunur</div>
    </main>

</body>
</html>